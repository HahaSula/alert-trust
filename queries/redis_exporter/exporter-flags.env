# redis_exporter v1.97.0 的建議設定（環境變數形式，對應的 flag 寫在每行上面）。
# 用法：docker run --env-file exporter-flags.env oliver006/redis_exporter:v1.97.0
# 依據：lab/targets/valkey（results/run-20261109.txt、run2-20261109.txt）與 exporter 原始碼，見 docs/targets/valkey.md#recommended。

# --connection-timeout：預設 15s，比一般的 scrape_timeout（10s）長；伺服器忙時 Prometheus 先放棄，up=0、redis_up 消失。
# 設得比 scrape_timeout 短，exporter 會自己回 redis_up=0 與錯誤訊息（實測 2s：2.2 秒回應）。
REDIS_EXPORTER_CONNECTION_TIMEOUT=5s

# --script＋--lua-script-read-only：補 INFO 裡有、exporter 沒輸出的欄位（master_link_down_since_seconds、min_slaves_good_slaves、total_forks）。
# 注意：script 出錯時 redis_up 被設成 0（其他 metric 照常輸出），要搭配 ValkeyExporterScriptFailed。
REDIS_EXPORTER_SCRIPT=/etc/redis_exporter/valkey-extra.lua
REDIS_EXPORTER_LUA_SCRIPT_READ_ONLY=true

# --check-single-keys：複本端讀 heartbeat key（應用或 cron 每秒在主節點 SET at:heartbeat <unix 秒>），
# time() - redis_key_value{key="at:heartbeat"} 是真正的資料延遲（秒）。只讀一個 key，成本可以忽略。
REDIS_EXPORTER_CHECK_SINGLE_KEYS=db0=at:heartbeat

# --check-key-groups：依 Lua pattern 分組統計 key 數與 MEMORY USAGE。每次 scrape 掃整個 keyspace，
# 每批（--check-keys-batch-size，預設 1000）一個 EVALSHA 在主執行緒上執行；實測 40 萬個 key 時一次 scrape 0.93 秒、
# 每批 1.2～2ms，slowlog（門檻 1ms 時）128 筆全被 exporter 自己的 EVALSHA 佔滿。
# 大型實例不要每次 scrape 都跑：另設一個 scrape_interval 長（例如 10m）的 job，或只在複本上跑
# （--skip-checkkeys-for-role-master 只管 check-keys／count-keys／streams，不管 key group）。
# REDIS_EXPORTER_CHECK_KEY_GROUPS=^(%a+):
# REDIS_EXPORTER_MAX_DISTINCT_KEY_GROUPS=100
